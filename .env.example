# Copier en .env puis remplacer les valeurs. Le fichier .env n'est jamais versionné.
POSTGRES_USER=enso
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enso

# Port local de l'application (http://localhost:8080)
WEB_PORT=8080

